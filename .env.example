# ============================================================
#  SOLANA SNIPER BOT — CONFIGURATIE
# ============================================================

# Jouw Solana wallet private key (base58 encoded)
# Maak een NIEUW wallet aan voor de bot, stuur er alleen trading capital naartoe
PRIVATE_KEY=je_private_key_hier

# RPC endpoint — gebruik Helius of QuickNode voor snelheid
# Gratis: https://www.helius.dev (100k requests/dag gratis)
# Snelste optie (betaald): https://www.quicknode.com
RPC_URL=https://mainnet.helius-rpc.com/?api-key=JOUW_API_KEY

# WebSocket RPC (zelfde provider, ws:// of wss://)
WS_URL=wss://mainnet.helius-rpc.com/?api-key=JOUW_API_KEY

# ============================================================
#  TRADING INSTELLINGEN
# ============================================================

# Hoeveel SOL per trade (bijv. 0.05 = 0.05 SOL per buy)
BUY_AMOUNT_SOL=0.05

# Max slippage bij kopen (30% toegestaan voor snelheid bij nieuwe launches)
MAX_SLIPPAGE=0.3

# Welke strategie: "pumpfun" | "raydium" | "both"
STRATEGY=both

# Max aantal open posities tegelijk
MAX_OPEN_POSITIONS=3

# ============================================================
#  SELL STRATEGIE — Partial sells + Trailing stop
# ============================================================
#
#  Beste aanpak voor memecoins:
#  1. Verkoop 50% bij 2x  → inleg terug + winst, stop loss naar breakeven
#  2. Verkoop 30% bij 5x  → grote winst gerealiseerd
#  3. Laat 20% doorlopen  → trailing stop vangt 10x/50x/100x moves
#
#  Voorbeeld met 0.05 SOL inleg:
#   - 2x: +0.05 SOL (inleg terug)
#   - 5x: +0.075 SOL
#   - Als daarna 20x en trailing stop op -20% van ATH triggert: +0.08 SOL
#   - Totaal: ~0.205 SOL winst op 0.05 SOL inleg = ~4x

# Fase 1: verkoop X% van tokens bij Y multiplier
PARTIAL_SELL_1_MULTIPLIER=2
PARTIAL_SELL_1_PERCENT=0.50

# Fase 2: verkoop X% van tokens bij Y multiplier
PARTIAL_SELL_2_MULTIPLIER=5
PARTIAL_SELL_2_PERCENT=0.30

# Trailing stop: verkoop resterende tokens als prijs X% daalt van ATH
# 0.20 = verkoop als prijs 20% daalt van hoogste punt
TRAILING_STOP_PERCENT=0.20

# Hard stop loss: verkoop ALLES als prijs X% daalt na aankoop (rug pull bescherming)
# 0.05 = verkoop bij -5% verlies
STOP_LOSS_PERCENT=0.05

# ============================================================
#  FILTER INSTELLINGEN (bescherming tegen rug pulls)
# ============================================================

# Minimale liquiditeit bij Raydium pool (in SOL)
MIN_LIQUIDITY_SOL=10

# Max % tokens in dev wallet (bijv. 0.15 = max 15%)
MAX_DEV_WALLET_PERCENT=0.15

# Negeer tokens waarbij top 10 wallets meer dan X% hebben
MAX_TOP10_PERCENT=0.5

# ============================================================
#  JITO MEV PROTECTION (optioneel, voor snellere transacties)
# ============================================================

# Gebruik Jito voor bundle transactions (sneller, kleine tip)
USE_JITO=false
JITO_TIP_LAMPORTS=10000
