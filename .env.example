# ============================================================
#  SOLANA KILLER BOT — VOLLEDIGE CONFIGURATIE
# ============================================================

# ── Wallet & RPC ─────────────────────────────────────────────
# Maak een NIEUW wallet aan voor de bot. Stuur er alleen trading capital naartoe.
PRIVATE_KEY=je_private_key_base58

# Helius (aanbevolen): https://helius.dev — gratis tot 100k req/dag
# QuickNode (sneller): https://quicknode.com — $49/mnd
# Triton (professioneel): ~$200/mnd
RPC_URL=https://mainnet.helius-rpc.com/?api-key=JOUW_HELIUS_KEY
WS_URL=wss://mainnet.helius-rpc.com/?api-key=JOUW_HELIUS_KEY

# ── Modus ─────────────────────────────────────────────────────
# DRY_RUN=true → simuleer alles zonder echt geld (aanbevolen om mee te starten!)
DRY_RUN=false

# Strategie:
#   "pumpfun"     → alleen nieuwe pump.fun launches snipen
#   "pumpswap"    → alleen bonding curve graduations (PumpSwap AMM)
#   "copytrading" → alleen wallets kopiëren
#   "both"        → alles tegelijk (meeste kansen)
STRATEGY=both

# ── Trading ───────────────────────────────────────────────────
BUY_AMOUNT_SOL=0.05
MAX_SLIPPAGE=0.3
MAX_OPEN_POSITIONS=3

# Stop bot als dit bedrag op één dag verloren is (risicobeheer)
MAX_DAILY_LOSS_SOL=0.5

# ── Sell strategie ─────────────────────────────────────────────
# Fase 1: verkoop 50% bij 2x → inleg altijd terug
PARTIAL_SELL_1_MULTIPLIER=2
PARTIAL_SELL_1_PERCENT=0.50

# Fase 2: verkoop 30% bij 5x → grote winst
PARTIAL_SELL_2_MULTIPLIER=5
PARTIAL_SELL_2_PERCENT=0.30

# Trailing stop: verkoop resterende 20% als prijs -20% daalt van ATH
TRAILING_STOP_PERCENT=0.20

# Hard stop loss: verkoop ALLES bij -5% (rug pull bescherming)
STOP_LOSS_PERCENT=0.05

# ── Rugcheck filters ──────────────────────────────────────────
MIN_LIQUIDITY_SOL=10
MAX_DEV_WALLET_PERCENT=0.15
MAX_TOP10_PERCENT=0.50

# ── Copy Trading ──────────────────────────────────────────────
# Komma-gescheiden lijst van wallets om te kopiëren
# Vind top wallets op: cielo.finance, gmgn.ai, dexscreener.com/solana
# Zoek: win rate >70%, >50 trades, gemiddeld >2x return
COPY_WALLETS=wallet1_address,wallet2_address

# Kopieer ook sells van target wallets (agressiever)
COPY_BUYS=true
COPY_SELLS=false

# Minimale SOL die target wallet moet kopen (filter kleine test trades)
MIN_TARGET_BUY_SOL=0.1

# ── Transaction Providers (snelheid) ──────────────────────────
# Bot stuurt transacties tegelijk naar alle geconfigureerde providers.
# Snelste bevestiging wint. Meer providers = sneller, maar meer kosten.

# Jito (aanbevolen, gratis te gebruiken — betaal tip per TX)
JITO_ENDPOINT=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000

# NextBlock (optioneel, snel voor EU)
# Aanvragen op: nextblock.io
NEXTBLOCK_ENDPOINT=
NEXTBLOCK_API_KEY=

# BloxRoute (optioneel, groot relay netwerk)
# Aanvragen op: bloxroute.com
BLOXROUTE_ENDPOINT=
BLOXROUTE_API_KEY=

# ── Telegram notificaties ─────────────────────────────────────
# Setup: maak bot via @BotFather → stuur bericht → haal chat_id op
# Tutorial: https://core.telegram.org/bots#creating-a-new-bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Simulatie ─────────────────────────────────────────────────
# Gesimuleerde startbalance voor dry-run modus
SIM_STARTING_BALANCE=1.0
